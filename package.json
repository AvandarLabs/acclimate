{
  "name": "@avandar/acclimate",
  "version": "0.5.0",
  "description": "A lightweight TypeScript framework for building CLI tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "demo": "tsx examples/basic.ts",
    "prepare": "npm run build",
    "type": "tsc -p tsconfig.json --noEmit",
    "changeset": "changeset",
    "changeset:version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "release:changesets": "tsx scripts/release/runEnsureChangesets.ts",
    "release:github": "tsx scripts/release/runCreateGithubRelease.ts",
    "skills": "tsx scripts/skills/SkillsCli.ts",
    "skills:install": "tsx scripts/skills/SkillsCli.ts install",
    "skills:update": "./scripts/skills/update-skills.sh",
    "format:check": "oxfmt --check ."
  },
  "keywords": [
    "cli",
    "framework",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AvandarLabs/acclimate.git"
  },
  "dependencies": {
    "change-case": "^5.4.4",
    "ts-pattern": "^5.9.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.19.2",
    "oxfmt": "^0.57.0",
    "oxlint": "^1.72.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "type-fest": "^5.3.1",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "publishConfig": {
    "access": "public"
  }
}
